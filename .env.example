# ODAOS - Oracle Database AI Operations System
# Environment Configuration

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================

# Provider: groq, ollama, or anthropic
ODAOS_LLM_PROVIDER=groq

# Groq API (recommended - fast and free tier available)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, private)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Anthropic (Claude models)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ==============================================================================
# OCI Configuration (for Cost Optimization)
# ==============================================================================

OCI_CONFIG_PATH=~/.oci/config
OCI_PROFILE=DEFAULT

# ==============================================================================
# Oracle Database Connection (Optional - uses mock data if not configured)
# ==============================================================================

# Direct connection
ORACLE_DSN=localhost:1521/ORCL
ORACLE_USER=system
ORACLE_PASSWORD=your_password_here

# SSH Tunnel via Bastion (for cloud database access)
BASTION_HOST=your_bastion_ip
BASTION_USER=opc
BASTION_KEY_PATH=~/.ssh/bastion_key.pem
DB_PRIVATE_IP=10.0.1.100
LOCAL_PORT=1521

# ==============================================================================
# Application Settings
# ==============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable debug mode
DEBUG=false
